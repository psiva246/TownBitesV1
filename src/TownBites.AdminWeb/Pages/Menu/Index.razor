@page "/menu"
@using TownBites.AdminWeb.Interfaces
@using TownBites.AdminWeb.Models.Menu

@inject IMenuAdminService MenuService
@inject NavigationManager Navigation

<PageTitle>Menu Management</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3>
            <i class="bi bi-list"></i>
            Menu Management
        </h3>

        <button class="btn btn-primary"
                @onclick="AddMenu">
            <i class="bi bi-plus-circle"></i>
            Add Menu Item
        </button>

    </div>

    <!-- Search -->

    <div class="row mb-3">

        <div class="col-md-4">

            <input class="form-control"
                   placeholder="Search..."
                   @bind="searchText"
                   @bind:event="oninput" />

        </div>

        <div class="col-md-3">

            <select class="form-select"
                    @bind="selectedStatus">

                <option value="">All Status</option>
                <option>Available</option>
                <option>Unavailable</option>

            </select>

        </div>

        <div class="col-md-3">

            <button class="btn btn-secondary"
                    @onclick="LoadData">
                Search
            </button>

        </div>

    </div>

    @if (isLoading)
    {
        <div class="text-center mt-5">

            <div class="spinner-border text-primary"></div>

        </div>
    }
    else
    {
        <table class="table table-striped table-hover">

            <thead class="table-dark">

                <tr>

                    <th>Image</th>

                    <th>Name</th>

                    <th>Category</th>

                    <th>Price</th>

                    <th>Status</th>

                    <th width="220">Actions</th>

                </tr>

            </thead>

            <tbody>

                @if (menuItems.Any())
                {
                    @foreach (var item in FilteredItems)
                    {
                        <tr>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         width="70"
                                         height="70"
                                         class="rounded" />
                                }

                            </td>

                            <td>

                                <strong>@item.Name</strong>

                            </td>

                            <td>

                                @item.CategoryName

                            </td>

                            <td>

                                @item.Price.ToString("C", System.Globalization.CultureInfo.CurrentCulture)

                            </td>

                            <td>

                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Unavailable
                                    </span>
                                }

                            </td>

                            <td>

                                <button class="btn btn-sm btn-warning me-2"
                                        @onclick="() => Edit(item.Id)">
                                    Edit
                                </button>

                                <button class="btn btn-sm btn-danger me-2"
                                        @onclick="() => Delete(item.Id)">
                                    Delete
                                </button>

                                <button class="btn btn-sm btn-info"
                                        @onclick="() => Toggle(item.Id)">

                                    @(item.IsAvailable ? "Disable" : "Enable")

                                </button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center">

                            No Menu Items Found

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>

@code {

    private List<MenuItemModel> menuItems = new();

    private bool isLoading;

    private string searchText = "";

    private string selectedStatus = "";

    private IEnumerable<MenuItemModel> FilteredItems =>
        menuItems.Where(x =>
            (string.IsNullOrWhiteSpace(searchText)
             || x.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            &&
            (string.IsNullOrWhiteSpace(selectedStatus)
             || (selectedStatus == "Available" && x.IsAvailable)
             || (selectedStatus == "Unavailable" && !x.IsAvailable)));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        menuItems = await MenuService.GetAllAsync();

        isLoading = false;
    }

    private void AddMenu()
    {
        Navigation.NavigateTo("/menu/add");
    }

    private void Edit(int id)
    {
        Navigation.NavigateTo($"/menu/edit/{id}");
    }

    private async Task Delete(int id)
    {
        var result = await MenuService.DeleteAsync(id);

        if (result)
            await LoadData();
    }

    private async Task Toggle(int id)
    {
        var result = await MenuService.ToggleAvailabilityAsync(id);

        if (result)
            await LoadData();
    }

}