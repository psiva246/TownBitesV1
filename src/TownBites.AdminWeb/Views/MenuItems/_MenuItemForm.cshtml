@model TownBites.AdminWeb.Models.Menu.MenuItemRequest

@using TownBites.AdminWeb.Models.Category

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row">

    <div class="col-md-6">

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>

            <input asp-for="Name"
                   class="form-control"
                   placeholder="Enter menu item name" />

            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

    </div>

    <div class="col-md-6">

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label"></label>

            <select asp-for="CategoryId"
                    class="form-select">

                <option value="">-- Select Category --</option>

                @foreach (var category in (ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>()))
                {
                    <option value="@category.Id">
                        @category.Name
                    </option>
                }

            </select>

            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

    </div>

</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>

    <textarea asp-for="Description"
              class="form-control"
              rows="4"
              placeholder="Enter menu item description"></textarea>

    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row">

    <div class="col-md-6">

        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>

            <input asp-for="Price"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="1" />

            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

    </div>

    <div class="col-md-6">

        <div class="mb-3">
            <label asp-for="DiscountPrice" class="form-label"></label>

            <input asp-for="DiscountPrice"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="1" />

            <span asp-validation-for="DiscountPrice" class="text-danger"></span>
        </div>

    </div>
</div>
<div class="row">
        
    <div class="col-md-6">

        <div class="mb-3">
            <label asp-for="RestaurantId" class="form-label"></label>

            <input asp-for="RestaurantId"
                   class="form-control"
                   type="number"
                   min="1" />

            <span asp-validation-for="RestaurantId" class="text-danger"></span>
        </div>

    </div>

</div>
<div class="mb-3">

    <label class="form-label">
        Menu Item Image
    </label>

    @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
    {
        <div class="mb-3">

            <img src="@Model.ExistingImageUrl"
                 alt="@Model.Name"
                 class="img-thumbnail"
                 style="width:200px; height:150px; object-fit:cover;" />

        </div>
    }
    else
    {
        <div class="mb-3">
            <span class="text-muted">
                No image available
            </span>
        </div>
    }

    <input asp-for="ImageUrl"
           type="file"
           class="form-control"
           accept=".jpg,.jpeg,.png,.gif,.webp" />

    <div class="form-text">
        Select a new image to replace the existing image.
    </div>

    <span asp-validation-for="ImageUrl"
          class="text-danger"></span>

</div>
