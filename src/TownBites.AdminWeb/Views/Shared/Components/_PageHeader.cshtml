@model TownBites.AdminWeb.ViewModels.PageHeaderViewModel

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">@Model.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Model.SubTitle))
        {
            <small class="text-muted"> @Model.SubTitle </small>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ButtonText))
    {
        <a href="@Model.ButtonUrl" class="btn btn-primary">
            <i class="@Model.ButtonIcon"></i>
            @Model.ButtonText
        </a>
    }
</div>