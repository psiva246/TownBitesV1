<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TownBites.CustomerApp.Views.Orders.OrderDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Order Details">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="{Binding OrderNumber}"
                FontSize="22"
                FontAttributes="Bold"/>

            <Label Text="{Binding RestaurantName}"/>

            <Label Text="{Binding DeliveryAddress}"/>

            <Label
                Text="{Binding Status}"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Green"/>

            <CollectionView ItemsSource="{Binding Items}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Grid ColumnDefinitions="*,Auto,Auto">

                            <Label Text="{Binding ItemName}"/>

                            <Label
                                Grid.Column="1"
                                Text="{Binding Quantity}"/>

                            <Label
                                Grid.Column="2"
                                Text="{Binding Total,StringFormat='₹{0:F2}'}"/>

                        </Grid>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                Text="{Binding TotalAmount,StringFormat='Grand Total : ₹{0:F2}'}"
                FontSize="20"
                FontAttributes="Bold"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>